# ---------- Front (Vite) ----------
# Opcional: chave "Demo" grátis da CoinGecko, só aumenta o limite de requisições
VITE_COINGECKO_API_KEY=
# "false" esconde o botão de alertas (ex.: deploy sem banco)
VITE_ALERTS_ENABLED=true

# ---------- Backend (funções da Vercel em /api) ----------
# Postgres (Neon pela integração da Vercel, ou Supabase). Use a URL com pooler.
DATABASE_URL=
# Token da brapi.dev (plano gratuito)
BRAPI_TOKEN=
# Resend: chave da API e remetente de um domínio verificado
RESEND_API_KEY=
ALERTS_FROM=Market Tracker <alertas@wallaceluis.com.br>
# URL pública do app, usada nos links dos e-mails
APP_URL=https://coins-tracker-taupe.vercel.app
# Segredo que o cron do GitHub Actions envia em Authorization: Bearer ...
CRON_SECRET=
